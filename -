import json, sys
from recipe.phimm.reward.asr_inhouse_measure import ensure_pack_dir, _compute_dter, _clean_ref, eval_score, DEFAULT_PACK_DIR
from recipe.phimm.utils.shared import parse_asr_response
ensure_pack_dir(DEFAULT_PACK_DIR)

with open("/root/our0.jsonl") as f:
    lines = f.readlines()

rec = json.loads(lines[0])
ref = rec["gts"]
hyp_raw = rec["output"]
parsed = parse_asr_response(hyp_raw)
hyp = parsed["text"]
print("REF[:300]:", repr(ref[:300]))
print("REF_CLEAN[:300]:", repr(_clean_ref(ref)[:300]))
print("HYP[:300]:", repr(hyp[:300]))
res = eval_score(hyp_raw, ref)
print("RESULT:", res)

# Now strip ALL inline time markers
import re
TIME_ALL = re.compile(r"\[\s*-?\d+(?:\.\d+)?\s+-?\d+(?:\.\d+)?\s*\]")
ref2 = TIME_ALL.sub(" ", ref).strip()
ref2 = re.sub(r"\s+", " ", ref2)
print("REF2[:300]:", repr(ref2[:300]))
n_err, n_ref, dter = _compute_dter(ref2, hyp)
print(f"After stripping ALL time markers: dter={dter:.4f} ({n_err}/{n_ref})")
